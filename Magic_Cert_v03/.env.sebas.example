# Local deployment profile for the standalone demo account.
# Copy to .env before using the scripts. Never commit .env.
AWS_PROFILE=sebas
AWS_REGION=us-east-1

# The parent account must delegate cert.glaciar.org to this child hosted zone.
TF_VAR_custom_domain_name=cert.glaciar.org
TF_VAR_hosted_zone_name=cert.glaciar.org
TF_VAR_deployment_id=sebas

# Bedrock is in the same account for this deployment; no AssumeRole is needed.
TF_VAR_bedrock_role_arn=
TF_VAR_bedrock_role_external_id=
TF_VAR_bedrock_region=us-east-1
TF_VAR_bedrock_model_id=amazon.nova-2-lite-v1:0
TF_VAR_ai_daily_quota_per_user=20
TF_VAR_api_throttling_rate_limit=10
TF_VAR_api_throttling_burst_limit=20

# Create/bootstrap this bucket in account 442809140287 before remote-state init.
TF_STATE_BUCKET=magic-cert-terraform-state-442809140287
