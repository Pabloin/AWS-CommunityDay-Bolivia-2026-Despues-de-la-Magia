# Local bootstrap configuration. Copy to .env; never commit .env.
AWS_PROFILE=magic-account
AWS_REGION=us-east-1
TF_VAR_custom_domain_name=cert.magic.glaciar.org
TF_VAR_hosted_zone_name=magic.glaciar.org
GITHUB_OWNER=Pabloin
GITHUB_REPOSITORY=AWS-CommunityDay-Bolivia-2026-Despues-de-la-Magia
GITHUB_OWNER_ID=21208987
GITHUB_REPOSITORY_ID=1345231004
GITHUB_PRODUCTION_ENVIRONMENT=production
TF_STATE_BUCKET=magic-cert-terraform-state-YOUR_ACCOUNT_ID

# Optional AI/Bedrock settings. The role lives in the separate Bedrock account.
TF_VAR_bedrock_role_arn=arn:aws:iam::123456789012:role/MagicCertBedrockInvokeRole
TF_VAR_bedrock_role_external_id=replace-with-shared-external-id
TF_VAR_bedrock_region=us-east-1
TF_VAR_bedrock_model_id=amazon.nova-lite-v1:0
TF_VAR_ai_daily_quota_per_user=20
TF_VAR_api_throttling_rate_limit=10
TF_VAR_api_throttling_burst_limit=20
